<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>QuizLocal - Economia Colaborativa</title>
<style>
  :root { --gold: #ffd700; --dark: #1a0033; --purple: #4a0e7a; --green: #27ae60; --red: #c0392b; }
  { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',sans-serif; -webkit-tap-highlight-color:transparent; }
  body { background:linear-gradient(135deg,var(--dark),var(--purple)); min-height:100vh; color:#fff; padding:15px; user-select:none; }
  .container { max-width:800px; margin:0 auto; }
  
  /* Header */
  header { text-align:center; padding:15px; background:linear-gradient(90deg,var(--gold),#ff8c00); border-radius:12px; color:var(--dark); margin-bottom:15px; box-shadow:0 0 20px rgba(255,215,0,0.4); }
  header h1 { font-size:1.8em; } header p { font-size:0.9em; opacity:0.9; }

  /* Marquee Horizontal (Esquerda para Direita) */
  .marquee-container {
    width: 100%;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid rgba(255, 215, 0, 0.3);
    padding: 12px 0;
    margin-bottom: 15px;
    position: relative;
    white-space: nowrap;
  }

  /* Máscara de fade nas bordas laterais */
  .marquee-container::before,
  .marquee-container::after {
    content: "";
    position: absolute;
    top: 0; bottom: 0;
    width: 60px;
    z-index: 2;
    pointer-events: none;
  }
  .marquee-container::before { left: 0; background: linear-gradient(to right, var(--dark), transparent); }
  .marquee-container::after { right: 0; background: linear-gradient(to left, var(--dark), transparent); }

  .marquee-track {
    display: inline-flex;
    animation: marquee-h-scroll 25s linear infinite;
  }

  .marquee-content {
    display: flex;
    align-items: center;
    gap: 40px; /* Espaço entre os itens */
    padding-right: 40px;
  }

  .marquee-content span {
    color: var(--gold);
    font-weight: bold;
    font-size: 1em;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.9;
  }

  /* Pausa ao passar o mouse */
  .marquee-container:hover .marquee-track {
    animation-play-state: paused;
  }

  /* Animação: Move de -50% (metade do conteúdo duplicado) para 0 */
  @keyframes marquee-h-scroll {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Screens */
  .screen { display:none; animation:fadeIn 0.4s; }
  .screen.active { display:block; }
  @keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }

  /* Cards & Buttons */
  .card { background:rgba(255,255,255,0.08); backdrop-filter:blur(8px); border:1px solid rgba(255,215,0,0.2); border-radius:12px; padding:20px; margin-bottom:15px; }
  .btn { background:linear-gradient(90deg,var(--gold),#ff8c00); color:var(--dark); border:none; padding:12px 25px; border-radius:25px; font-weight:bold; cursor:pointer; width:100%; margin-top:10px; font-size:1em; transition:0.2s; }
  .btn:active { transform:scale(0.97); }
  .btn-sm { width:auto; padding:8px 18px; font-size:0.9em; }
  .btn-red { background:linear-gradient(90deg,var(--red),#e74c3c); color:#fff; }
  .btn-green { background:linear-gradient(90deg,var(--green),#2ecc71); color:#fff; }
  .btn-purple { background:linear-gradient(90deg,#6a0dad,#9b30ff); color:#fff; }
  .back-btn { background:none; border:1px solid rgba(255,255,255,0.3); color:#fff; padding:6px 15px; border-radius:20px; cursor:pointer; margin-bottom:10px; font-size:0.85em; }

  /* Inputs */
  input,select { width:100%; padding:12px; margin:6px 0; border-radius:8px; border:1px solid rgba(255,215,0,0.4); background:rgba(255,255,255,0.1); color:#fff; font-size:1em; }
  input::placeholder { color:rgba(255,255,255,0.5); }
  label { display:block; margin-top:10px; color:var(--gold); font-weight:bold; font-size:0.9em; }

  /* Info Box */
  .info { background:rgba(52,152,219,0.15); border-left:3px solid #3498db; padding:12px; border-radius:6px; margin:12px 0; font-size:0.9em; line-height:1.5; }
  .info strong { color:#3498db; }

  /* Quiz */
  .q-box { background:linear-gradient(135deg,#2c0054,var(--purple)); border:2px solid var(--gold); border-radius:15px; padding:25px; text-align:center; margin:15px 0; }
  .q-text { font-size:1.2em; margin-bottom:20px; line-height:1.4; }
  .opt { background:rgba(255,255,255,0.1); border:2px solid rgba(255,215,0,0.4); padding:14px; border-radius:10px; margin:8px 0; cursor:pointer; text-align:left; transition:0.2s; }
  .opt:active { transform:translateX(3px); }
  .opt.correct { background:var(--green)!important; border-color:#2ecc71; }
  .opt.wrong { background:var(--red)!important; border-color:#e74c3c; }
  .timer-bar { height:6px; background:rgba(255,255,255,0.2); border-radius:3px; overflow:hidden; margin-bottom:15px; }
  .timer-fill { height:100%; background:var(--gold); transition:width 1s linear; }

  /* Stats Grid */
  .stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:10px; margin:15px 0; }
  .stat { background:rgba(255,215,0,0.1); padding:15px; border-radius:10px; text-align:center; border:1px solid rgba(255,215,0,0.2); }
  .stat-val { font-size:1.6em; color:var(--gold); font-weight:bold; }
  .stat-lbl { font-size:0.75em; opacity:0.8; margin-top:4px; }

  /* Top Bar */
  .topbar { display:flex; justify-content:space-between; align-items:center; background:rgba(0,0,0,0.3); padding:10px 15px; border-radius:10px; margin-bottom:12px; flex-wrap:wrap; gap:8px; }
  .pts-badge { background:linear-gradient(90deg,var(--gold),#ff8c00); color:var(--dark); padding:6px 15px; border-radius:20px; font-weight:bold; font-size:0.9em; }

  /* Product Card */
  .prod-card { background:rgba(255,255,255,0.08); border:1px solid rgba(255,215,0,0.3); border-radius:10px; padding:15px; margin:10px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px; }
  .prod-card h4 { color:var(--gold); margin-bottom:4px; }

  /* Toast */
  .toast { position:fixed; top:15px; right:15px; padding:12px 20px; border-radius:10px; color:#fff; font-weight:bold; z-index:9999; animation:slideIn 0.3s; font-size:0.9em; max-width:90%; }
  .toast.success { background:var(--green); } .toast.error { background:var(--red); } .toast.info { background:#2980b9; }
  @keyframes slideIn { from{transform:translateX(100%)} to{transform:translateX(0)} }

  /* Modal */
  .modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.85); z-index:9998; justify-content:center; align-items:center; padding:20px; }
  .modal.active { display:flex; }
  .modal-box { background:linear-gradient(135deg,#2c0054,var(--purple)); border:2px solid var(--gold); border-radius:15px; padding:25px; max-width:450px; width:100%; text-align:center; }
  .modal-icon { font-size:3em; margin-bottom:10px; }

  /* Table */
  table { width:100%; border-collapse:collapse; margin-top:10px; font-size:0.85em; }
  th,td { padding:8px; text-align:left; border-bottom:1px solid rgba(255,215,0,0.15); }
  th { color:var(--gold); background:rgba(255,215,0,0.1); }

  .hidden { display:none!important; }
</style>
</head>
<body>
<div class="container">
  <header>
    <h1>🎯 QuizLocal</h1>
    <p>Conectando Saberes e Comércio Local</p>
  </header>

  <!-- FAIXA DE PATROCINADORES HORIZONTAL -->
  <div class="marquee-container">
    <div class="marquee-track">
      <!-- Conjunto 1 -->
      <div class="marquee-content">
        <span>🏪 Padaria Central</span>
        <span>💊 Farmácia Saúde</span>
        <span>🛒 Mercado Bom Preço</span>
        <span>✂️ Salão Estilo</span>
        <span>🔧 Oficina Mecânica Silva</span>
        <span>🍕 Pizzaria da Nonna</span>
        <span>👗 Moda Elegante</span>
        <span>🏗️ Material Construção João</span>
      </div>
      <!-- Conjunto 2 (Duplicado para loop infinito) -->
      <div class="marquee-content" aria-hidden="true">
        <span>🏪 Padaria Central</span>
        <span>💊 Farmácia Saúde</span>
        <span>🛒 Mercado Bom Preço</span>
        <span>✂️ Salão Estilo</span>
        <span>🔧 Oficina Mecânica Silva</span>
        <span>🍕 Pizzaria da Nonna</span>
        <span>👗 Moda Elegante</span>
        <span>🏗️ Material Construção João</span>
      </div>
    </div>
  </div>

  <!-- ========== TELA: HOME / LOGIN ========== -->
  <div id="scr-home" class="screen active">
    <div class="card">
      <div class="info">
        <strong>📋 Como funciona:</strong><br>
        • Responda perguntas e acumule pontos<br>
        • <strong>1.000 pontos = R 1,00</strong> em desconto<br>
        • Desconto máximo de <strong>10% por compra</strong><br>
        • Válido apenas no comércio local parceiro<br>
        • Não aplicável a taxas de entrega
      </div>
      <label>Nome Completo:</label>
      <input type="text" id="reg-name" placeholder="Seu nome completo">
      <label>CPF (apenas números):</label>
      <input type="tel" id="reg-cpf" placeholder="00000000000" maxlength="11" inputmode="numeric">
      <label>E-mail Pessoal:</label>
      <input type="email" id="reg-email" placeholder="seu@email.com">
      <label>Senha:</label>
      <input type="password" id="reg-pass" placeholder="Crie uma senha forte">
      <label>Tipo de Conta:</label>
      <select id="reg-type">
        <option value="cliente">👤 Cliente</option>
        <option value="lojista">🏪 Lojista</option>
        <option value="admin">🛡️ Administrador</option>
      </select>
      <div id="store-field" class="hidden">
        <label>Nome do Estabelecimento:</label>
        <input type="text" id="reg-store" placeholder="Ex: Padaria Central">
      </div>
      <button class="btn" onclick="handleRegister()">Cadastrar / Entrar</button>
      <p style="text-align:center;margin-top:12px;font-size:0.8em;opacity:0.6;">Ao continuar, você concorda com os Termos de Uso.</p>
    </div>
  </div>

  <!-- ========== TELA: VERIFICAÇÃO DE E-MAIL ========== -->
  <div id="scr-verify" class="screen">
    <div class="card" style="text-align:center;">
      <div style="font-size:3em;margin-bottom:10px;">📧</div>
      <h2 style="color:var(--gold);margin-bottom:10px;">Verifique seu E-mail</h2>
      <p style="margin-bottom:15px;">Enviamos um código de 6 dígitos para <strong id="verify-email-display"></strong></p>
      <div class="info">
        <strong>⚠️ Importante:</strong> O código expira em 10 minutos. Verifique também sua caixa de spam.
      </div>
      <label>Código de Verificação:</label>
      <input type="tel" id="verify-code" placeholder="000000" maxlength="6" inputmode="numeric" style="text-align:center;font-size:1.5em;letter-spacing:8px;">
      <button class="btn btn-green" onclick="confirmVerification()">Verificar Código</button>
      <button class="btn btn-purple btn-sm" onclick="resendCode()" style="margin-top:8px;">Reenviar Código</button>
      <button class="back-btn" onclick="showScreen('scr-home')" style="margin-top:15px;">← Voltar</button>
    </div>
  </div>

  <!-- ========== TELA: DASHBOARD CLIENTE ========== -->
  <div id="scr-client" class="screen">
    <div class="topbar">
      <span>👤 <strong id="cli-name"></strong></span>
      <span class="pts-badge">💰 <span id="cli-pts">0</span> pts</span>
      <button class="back-btn" onclick="logout()" style="margin:0;">Sair</button>
    </div>
    <div class="card">
      <div class="stats">
        <div class="stat"><div class="stat-val" id="cli-balance">R 0</div><div class="stat-lbl">Saldo em Reais</div></div>
        <div class="stat"><div class="stat-val" id="cli-games">0</div><div class="stat-lbl">Quizes Jogados</div></div>
        <div class="stat"><div class="stat-val" id="cli-redeemed">R 0</div><div class="stat-lbl">Total Resgatado</div></div>
      </div>
      <button class="btn" onclick="startQuiz()">🎯 JOGAR QUIZ AGORA</button>
      <button class="btn btn-green" onclick="showScreen('scr-redeem')">🛍️ Resgatar Desconto</button>
      <button class="btn btn-purple" onclick="showScreen('scr-transfer')">🔄 Transferir Pontos</button>
      <button class="btn btn-sm" onclick="showScreen('scr-profile')" style="background:rgba(255,255,255,0.15);color:#fff;">📊 Meu Perfil</button>
    </div>
    <div class="info">
      <strong>💡 Dica:</strong> Jogue diariamente para manter seus pontos ativos. Transfira pontos para amigos (taxa de 20%). Limite: 5.000/dia e 150.000/mês.
    </div>
  </div>

  <!-- ========== TELA: QUIZ ========== -->
  <div id="scr-quiz" class="screen">
    <div class="topbar">
      <span>🎯 Pergunta <span id="q-num">1</span>/<span id="q-total">10</span></span>
      <span class="pts-badge">+<span id="q-round-pts">0</span> pts</span>
    </div>
    <div class="timer-bar"><div class="timer-fill" id="timer-fill" style="width:100%"></div></div>
    <div class="q-box">
      <div class="q-text" id="q-text">Carregando...</div>
      <div id="q-options"></div>
    </div>
  </div>

  <!-- ========== TELA: RESULTADO QUIZ ========== -->
  <div id="scr-result" class="screen">
    <div class="card" style="text-align:center;">
      <div style="font-size:4em;margin-bottom:10px;" id="res-icon">🏆</div>
      <h2 style="color:var(--gold);" id="res-title">Parabéns!</h2>
      <p id="res-msg" style="margin:15px 0;font-size:1.1em;"></p>
      <div class="stats">
        <div class="stat"><div class="stat-val" id="res-correct">0</div><div class="stat-lbl">Acertos</div></div>
        <div class="stat"><div class="stat-val" id="res-wrong">0</div><div class="stat-lbl">Erros</div></div>
        <div class="stat"><div class="stat-val" id="res-earned">0</div><div class="stat-lbl">Pontos Ganhos</div></div>
      </div>
      <button class="btn" onclick="showScreen('scr-client')">Voltar ao Menu</button>
      <button class="btn btn-green" onclick="startQuiz()">Jogar Novamente</button>
    </div>
  </div>

  <!-- ========== TELA: RESGATAR DESCONTO ========== -->
  <div id="scr-redeem" class="screen">
    <button class="back-btn" onclick="showScreen('scr-client')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:10px;">🛍️ Resgatar Desconto</h2>
      <div class="info">
        <strong>Regras de Resgate:</strong><br>
        • Desconto máximo: <strong>10% do valor da compra</strong><br>
        • 1.000 pontos = R 1,00 de desconto<br>
        • <strong>Não aplicável</strong> a taxas de entrega/frete<br>
        • Informe apenas o valor dos produtos/serviços
      </div>
      <label>Loja Parceira:</label>
      <select id="redeem-store"></select>
      <label>Valor da Compra (sem entrega):</label>
      <input type="number" id="redeem-value" placeholder="Ex: 150.00" step="0.01" min="0">
      <div id="redeem-preview" class="hidden" style="background:rgba(255,215,0,0.1);padding:12px;border-radius:8px;margin:10px 0;font-size:0.9em;"></div>
      <button class="btn btn-green" onclick="previewRedeem()">Calcular Desconto</button>
      <button class="btn hidden" id="btn-confirm-redeem" onclick="confirmRedeem()">✅ Confirmar Resgate</button>
    </div>
  </div>

  <!-- ========== TELA: TRANSFERIR PONTOS ========== -->
  <div id="scr-transfer" class="screen">
    <button class="back-btn" onclick="showScreen('scr-client')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:10px;">🔄 Transferir Pontos</h2>
      <div class="info">
        <strong>Regras de Transferência:</strong><br>
        • Taxa: <strong>20%</strong> (vai para o caixa do projeto)<br>
        • Limite diário: <strong>5.000 pontos</strong><br>
        • Limite mensal: <strong>150.000 pontos</strong><br>
        • O destinatário recebe o valor líquido (após taxa)
      </div>
      <label>CPF do Destinatário:</label>
      <input type="tel" id="tr-cpf" placeholder="00000000000" maxlength="11" inputmode="numeric">
      <label>Quantidade de Pontos:</label>
      <input type="number" id="tr-amount" placeholder="Ex: 5000" min="100">
      <div id="tr-preview" class="hidden" style="background:rgba(255,215,0,0.1);padding:12px;border-radius:8px;margin:10px 0;font-size:0.9em;"></div>
      <button class="btn btn-purple" onclick="previewTransfer()">Simular Transferência</button>
      <button class="btn btn-green hidden" id="btn-confirm-tr" onclick="confirmTransfer()">✅ Confirmar Transferência</button>
    </div>
  </div>

  <!-- ========== TELA: PERFIL ========== -->
  <div id="scr-profile" class="screen">
    <button class="back-btn" onclick="showScreen('scr-client')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:15px;">📊 Meu Perfil</h2>
      <div class="stats">
        <div class="stat"><div class="stat-val" id="prof-pts">0</div><div class="stat-lbl">Pontos Atuais</div></div>
        <div class="stat"><div class="stat-val" id="prof-games">0</div><div class="stat-lbl">Quizes</div></div>
        <div class="stat"><div class="stat-val" id="prof-correct">0</div><div class="stat-lbl">Acertos Totais</div></div>
        <div class="stat"><div class="stat-val" id="prof-redeemed">R 0</div><div class="stat-lbl">Resgatado</div></div>
      </div>
      <h3 style="color:var(--gold);margin-top:15px;">📜 Histórico Recente</h3>
      <div id="prof-history"></div>
    </div>
  </div>

  <!-- ========== TELA: LOJISTA ========== -->
  <div id="scr-shopkeeper" class="screen">
    <div class="topbar">
      <span>🏪 <strong id="shop-name"></strong></span>
      <button class="back-btn" onclick="logout()" style="margin:0;">Sair</button>
    </div>
    <div class="card">
      <h2 style="color:var(--gold);text-align:center;margin-bottom:15px;">Painel do Lojista</h2>
      <div class="stats">
        <div class="stat"><div class="stat-val" id="shop-redeems">0</div><div class="stat-lbl">Resgates</div></div>
        <div class="stat"><div class="stat-val" id="shop-clients">0</div><div class="stat-lbl">Clientes</div></div>
        <div class="stat"><div class="stat-val" id="shop-total">R 0</div><div class="stat-lbl">Descontos Aplicados</div></div>
      </div>
      <button class="btn btn-green" onclick="showScreen('scr-validate')">✅ Validar Cupom</button>
      <button class="btn btn-purple" onclick="showScreen('scr-shop-products')">📦 Meus Produtos/Ofertas</button>
      <button class="btn" onclick="showScreen('scr-shop-add')">➕ Nova Oferta</button>
    </div>
  </div>

  <!-- ========== TELA: VALIDAR CUPOM ========== -->
  <div id="scr-validate" class="screen">
    <button class="back-btn" onclick="showScreen('scr-shopkeeper')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:10px;">✅ Validar Cupom</h2>
      <div class="info">Peça ao cliente o código do cupom e insira abaixo.</div>
      <label>Código do Cupom:</label>
      <input type="text" id="val-code" placeholder="QL-XXXXXX" style="text-transform:uppercase;text-align:center;font-size:1.3em;letter-spacing:3px;">
      <button class="btn btn-green" onclick="validateCoupon()">Validar</button>
      <div id="val-result" style="margin-top:15px;"></div>
    </div>
  </div>

  <!-- ========== TELA: NOVA OFERTA LOJISTA ========== -->
  <div id="scr-shop-add" class="screen">
    <button class="back-btn" onclick="showScreen('scr-shopkeeper')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:10px;">➕ Nova Oferta</h2>
      <label>Nome da Oferta:</label>
      <input type="text" id="offer-name" placeholder="Ex: Café Grátis">
      <label>Descrição:</label>
      <input type="text" id="offer-desc" placeholder="Ex: Café expresso gratuito na compra de qualquer salgado">
      <label>Pontos Necessários (mín. 1000):</label>
      <input type="number" id="offer-pts" placeholder="Ex: 5000" min="1000">
      <label>Estoque Disponível:</label>
      <input type="number" id="offer-stock" placeholder="Ex: 20" min="1">
      <button class="btn btn-green" onclick="addOffer()">Cadastrar Oferta</button>
    </div>
  </div>

  <!-- ========== TELA: MEUS PRODUTOS LOJISTA ========== -->
  <div id="scr-shop-products" class="screen">
    <button class="back-btn" onclick="showScreen('scr-shopkeeper')">← Voltar</button>
    <div class="card">
      <h2 style="color:var(--gold);margin-bottom:10px;">📦 Minhas Ofertas</h2>
      <div id="shop-prod-list"></div>
    </div>
  </div>

  <!-- ========== TELA: ADMIN ========== -->
  <div id="scr-admin" class="screen">
    <div class="topbar">
      <span>🛡️ <strong id="adm-name"></strong></span>
      <button class="back-btn" onclick="logout()" style="margin:0;">Sair</button>
    </div>
    <div class="card">
      <h2 style="color:var(--gold);text-align:center;margin-bottom:15px;">Painel Administrativo</h2>
      <div class="stats">
        <div class="stat"><div class="stat-val" id="adm-users">0</div><div class="stat-lbl">Usuários</div></div>
        <div class="stat"><div class="stat-val" id="adm-shops">0</div><div class="stat-lbl">Lojistas</div></div>
        <div class="stat"><div class="stat-val" id="adm-fund">R 0</div><div class="stat-lbl">Caixa do Projeto</div></div>
        <div class="stat"><div class="stat-val" id="adm-transfers">0</div><div class="stat-lbl">Transferências</div></div>
      </div>
      <button class="btn" onclick="renderAdminUsers()">👥 Usuários</button>
