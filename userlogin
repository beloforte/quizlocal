let quiz = {};
let timerInterval = null;

// Anti-cheat: detectar perda de foco
document.addEventListener('visibilitychange', () => {
  if(document.hidden && quiz.active) {
    clearInterval(timerInterval);
    quiz.caughtCheating = true;
    toast('⚠️ Saída detectada! Pergunta anulada.','error');
    sndWrong();
    setTimeout(nextQuestion, 1500);
  }
});

function startQuiz() {
  // Embaralhamento aleatório para prevenir fraudes entre usuários simultâneos
  const shuffled = [...QUESTIONS].sort(()=>Math.random()-0.5).slice(0,10);
  quiz = { questions:shuffled, current:0, correct:0, wrong:0, points:0, active:true, caughtCheating:false };
  document.getElementById('q-total').textContent = shuffled.length;
  showScreen('scr-quiz');
  renderQuestion();
}

function renderQuestion() {
  if(quiz.current >= quiz.questions.length) { finishQuiz(); return; }
  const q = quiz.questions[quiz.current];
  document.getElementById('q-num').textContent = quiz.current+1;
  document.getElementById('q-round-pts').textContent = quiz.points;
  document.getElementById('q-text').innerHTML = <small style="color:var(--gold)">[{q.c} • Dif. {q.d}]</small><br><br>{q.q};

  const opts = document.getElementById('q-options');
  opts.innerHTML = '';
  q.o.forEach((o,i) => {
    const d = document.createElement('div');
    d.className = 'opt';
    d.textContent = {String.fromCharCode(65+i)}) {o};
    d.onclick = () => answerQ(i, d);
    opts.appendChild(d);
  });

  // Timer baseado na dificuldade: Fácil=10, Médio=15, Difícil=20
  const seconds = q.d === 1 ? 10 : q.d === 2 ? 15 : 20;
  startTimer(seconds);
}

function startTimer(seconds) {
  clearInterval(timerInterval);
  const fill = document.getElementById('timer-fill');
  fill.style.transition = 'none'; fill.style.width = '100%';
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      fill.style.transition = width {seconds}s linear;
      fill.style.width = '0%';
    });
  });
  let remaining = seconds;
  timerInterval = setInterval(() => {
    remaining--;
    if(remaining <= 0) {
      clearInterval(timerInterval);
      quiz.wrong++;
      sndWrong();
      toast('⏰ Tempo esgotado!','error');
      setTimeout(nextQuestion, 1200);
    }
  }, 1000);
}

function answerQ(idx, el) {
  if(!quiz.active) return;
  clearInterval(timerInterval);
  quiz.active = false; // Previne duplo clique

  const q = quiz.questions[quiz.current];
  document.querySelectorAll('.opt').forEach(o => o.style.pointerEvents = 'none');

  const ptsValue = q.d * 100;

  if(idx === q.a) {
    el.classList.add('correct');
    quiz.correct++; 
    quiz.points += ptsValue; // Ganha pontos
    sndCorrect();
    toast(✅ Correto! +{ptsValue} pts,'success');
  } else {
    el.classList.add('wrong');
    document.querySelectorAll('.opt')[q.a]?.classList.add('correct');
    quiz.wrong++;
    quiz.points -= ptsValue; // Perde pontos (penalidade)
    sndWrong();
    toast(❌ Errado! -{ptsValue} pts,'error');
  }
  setTimeout(nextQuestion, 1600);
}

function nextQuestion() {
  quiz.active = true;
  quiz.current++;
  renderQuestion();
}

function finishQuiz() {
  quiz.active = false;
  clearInterval(timerInterval);
  const u = currentUser();
  u.points += quiz.points;
  u.gamesPlayed++;
  u.correctAnswers += quiz.correct;
  updateUser(u);

  document.getElementById('res-correct').textContent = quiz.correct;
  document.getElementById('res-wrong').textContent = quiz.wrong;
  document.getElementById('res-earned').textContent = quiz.points;

  const pct = quiz.correct / quiz.questions.length;
  if(pct >= 0.8) { document.getElementById('res-icon').textContent='🏆'; document.getElementById('res-title').textContent='Excelente!'; sndWin(); }
  else if(pct >= 0.5) { document.getElementById('res-icon').textContent='👍'; document.getElementById('res-title').textContent='Muito Bem!'; sndCorrect(); }
  else { document.getElementById('res-icon').textContent='💪'; document.getElementById('res-title').textContent='Continue Tentando!'; }
  document.getElementById('res-msg').textContent = Você acertou {quiz.correct}/{quiz.questions.length}. Saldo final da rodada: {quiz.points} pontos.;
  showScreen('scr-result');
}

// ==================== CLIENTE: REFRESH ====================
function refreshClient() {
  const u = currentUser(); if(!u) return;
  document.getElementById('cli-name').textContent = u.name;
  document.getElementById('cli-pts').textContent = u.points;
  document.getElementById('cli-balance').textContent = fmtMoney(u.points/1000);
