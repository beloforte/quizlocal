  const totalTax=db.transactions.filter(t=>t.type==='transfer').reduce((s,t)=>s+(t.tax||0),0);
  cont.innerHTML=
    <div class="stats">
      <div class="stat"><div class="stat-val">{totalPts}</div><div class="stat-lbl">Pontos em Circulação</div></div>
      <div class="stat"><div class="stat-val">{totalGames}</div><div class="stat-lbl">Quizes Realizados</div></div>
      <div class="stat"><div class="stat-val">{fmtMoney(totalRedeem)}</div><div class="stat-lbl">Total Resgatado</div></div>
