// ==================== RESGATE (DESCONTO MÁX 10%) ====================
function loadRedeemStores() {
  const sel = document.getElementById('redeem-store');
  const shops = db.users.filter(u => u.type==='lojista');
  sel.innerHTML = '<option value="">Selecione a loja...</option>';
  shops.forEach(s => { sel.innerHTML += <option value="{s.id}">{s.store}</option>; });
  document.getElementById('redeem-value').value = '';
  document.getElementById('redeem-preview').classList.add('hidden');
  document.getElementById('btn-confirm-redeem').classList.add('hidden');
}

function previewRedeem() {
  const storeId = document.getElementById('redeem-store').value;
  const val = parseFloat(document.getElementById('redeem-value').value);
  const u = currentUser();

  if(!storeId) { toast('Selecione uma loja!','error'); return; }
  if(!val || val <= 0) { toast('Informe um valor válido!','error'); return; }

  const maxDiscount = val * 0.10; // 10% máximo
  const neededPoints = Math.ceil(maxDiscount * 1000);
  const actualDiscount = Math.min(maxDiscount, u.points / 1000);
  const actualPoints = Math.ceil(actualDiscount * 1000);

  const prev = document.getElementById('redeem-preview');
  prev.classList.remove('hidden');
  prev.innerHTML = 
    <strong>📋 Resumo do Resgate:</strong><br>
    Valor da compra: {fmtMoney(val)}<br>
    Desconto máximo (10%): {fmtMoney(maxDiscount)}<br>
    Seus pontos disponíveis: {u.points} ({fmtMoney(u.points/1000)})<br>
    <strong style="color:var(--gold);font-size:1.1em;">Desconto aplicado: {fmtMoney(actualDiscount)}</strong><br>
    Pontos a deduzir: <strong>{actualPoints}</strong><br>
    {actualPoints > u.points ? '<span style="color:var(--red)">⚠️ Pontos insuficientes para desconto máximo</span>' : ''}
  ;

  SESSION.redeemData = { storeId, actualDiscount, actualPoints, purchaseValue: val };
  document.getElementById('btn-confirm-redeem').classList.remove('hidden');
}

function confirmRedeem() {
  const d = SESSION.redeemData;
  const u = currentUser();
  if(!d) return;
  if(u.points < d.actualPoints) { toast('Pontos insuficientes!','error'); return; }

  const code = 'QL-' + genCode(6);
  u.points -= d.actualPoints;
  u.totalRedeemed += d.actualDiscount;
  updateUser(u);

  db.transactions.push({
    id: Date.now(), type:'redeem', userId:u.id, userName:u.name,
    storeId:d.storeId, storeName:getUser(d.storeId)?.store,
    discount:d.actualDiscount, pointsUsed:d.actualPoints,
    purchaseValue:d.purchaseValue, code, status:'pendente',
    date: new Date().toISOString()
  });
  saveDB();

  sndWin();
  showModal('🎫','Cupom Gerado!',Código: {code}nnDesconto: {fmtMoney(d.actualDiscount)}nApresente este código no caixa da loja.nn⚠️ Não aplicável a taxas de entrega.);
  document.getElementById('redeem-preview').classList.add('hidden');
  document.getElementById('btn-confirm-redeem').classList.add('hidden');
  refreshClient();
}

// ==================== TRANSFERÊNCIA (20% TAXA, LIMITES) ====================
function previewTransfer() {
  const cpf = cleanCPF(document.getElementById('tr-cpf').value);
  const amount = parseInt(document.getElementById('tr-amount').value);
  const u = currentUser();

  if(!cpf || cpf.length!==11) { toast('CPF inválido!','error'); return; }
  if(!amount || amount < 100) { toast('Mínimo de 100 pontos!','error'); return; }
  if(amount > u.points) { toast('Saldo insuficiente!','error'); return; }

  // Verificar limites
  const today = todayStr();
  const month = monthStr();
  const todayTransfers = db.transactions.filter(t => t.type==='transfer' && t.fromId===u.id && t.date?.startsWith(today));
  const monthTransfers = db.transactions.filter(t => t.type==='transfer' && t.fromId===u.id && t.date?.startsWith(month));

  const todaySent = todayTransfers.reduce((s,t)=>s+t.amount,0);
  const monthSent = monthTransfers.reduce((s,t)=>s+t.amount,0);

  if(todaySent + amount > 5000) { toast(Limite diário excedido! Enviado hoje: {todaySent}/5.000,'error'); return; }
  if(monthSent + amount > 150000) { toast(Limite mensal excedido! Enviado este mês: {monthSent}/150.000,'error'); return; }

  // Verificar destinatário
  const dest = db.users.find(x => x.cpf === cpf && x.type === 'cliente');
  if(!dest) { toast('Destinatário não encontrado!','error'); return; }
  if(dest.id === u.id) { toast('Não pode transferir para si mesmo!','error'); return; }

  const tax = Math.floor(amount * 0.20);
  const net = amount - tax;

  const prev = document.getElementById('tr-preview');
  prev.classList.remove('hidden');
  prev.innerHTML = 
    <strong>📋 Simulação:</strong><br>
    Destinatário: <strong>{dest.name}</strong><br>
    Pontos enviados: {amount}<br>
    Taxa (20%): <strong>-{tax} pts</strong> → Caixa do Projeto<br>
    <strong style="color:var(--gold);font-size:1.1em;">Destinatário recebe: {net} pts</strong><br>
    Seu saldo após: {u.points - amount} pts
  ;

  SESSION.transferData = { destId:dest.id, destName:dest.name, amount, tax, net };
  document.getElementById('btn-confirm-tr').classList.remove('hidden');
}

function confirmTransfer() {
  const d = SESSION.transferData;
  const u = currentUser();
  if(!d) return;

  // Revalidar limites (segurança)
  const today = todayStr();
  const month = monthStr();
  const todaySent = db.transactions.filter(t=>t.type==='transfer'&&t.fromId===u.id&&t.date?.startsWith(today)).reduce((s,t)=>s+t.amount,0);
  const monthSent = db.transactions.filter(t=>t.type==='transfer'&&t.fromId===u.id&&t.date?.startsWith(month)).reduce((s,t)=>s+t.amount,0);
  if(todaySent+d.amount>5000||monthSent+d.amount>150000) { toast('Limites excedidos entre simulação e confirmação!','error'); return; }

  u.points -= d.amount;
  updateUser(u);

  const dest = getUser(d.destId);
  dest.points += d.net;
  updateUser(dest);

  db.projectFund += d.tax / 1000; // Taxa vai para caixa em reais

  db.transactions.push({
    id:Date.now(), type:'transfer', fromId:u.id, fromName:u.name,
    toId:d.destId, toName:d.destName,
    amount:d.amount, tax:d.tax, net:d.net,
    date:new Date().toISOString()
  });
  saveDB();

  sndCorrect();
  showModal('✅','Transferência Realizada!',{d.net} pontos enviados para {d.destName}.nTaxa de {d.tax} pts revertida ao caixa do projeto.);
  document.getElementById('tr-preview').classList.add('hidden');
  document.getElementById('btn-confirm-tr').classList.add('hidden');
  document.getElementById('tr-cpf').value = '';
  document.getElementById('tr-amount').value = '';
  refreshClient();
}

// ==================== PERFIL ====================
function refreshProfile() {
  const u = currentUser(); if(!u) return;
  document.getElementById('prof-pts').textContent = u.points;
  document.getElementById('prof-games').textContent = u.gamesPlayed;
  document.getElementById('prof-correct').textContent = u.correctAnswers;
  document.getElementById('prof-redeemed').textContent = fmtMoney(u.totalRedeemed);

  const hist = db.transactions.filter(t => t.userId===u.id || t.fromId===u.id || t.toId===u.id).slice(-10).reverse();
  const cont = document.getElementById('prof-history');
  if(!hist.length) { cont.innerHTML='<p style="opacity:0.6;text-align:center;padding:15px;">Sem histórico recente.</p>'; return; }
  cont.innerHTML='<table><tr><th>Data</th><th>Tipo</th><th>Detalhe</th></tr>';
  hist.forEach(t => {
    const d = new Date(t.date).toLocaleDateString('pt-BR');
    let detail = '';
    if(t.type==='redeem') detail=-{t.pointsUsed} pts → {t.storeName};
    else if(t.type==='transfer' && t.fromId===u.id) detail=-{t.amount} pts → {t.toName};
    else if(t.type==='transfer' && t.toId===u.id) detail=+{t.net} pts ← {t.fromName};
    else if(t.type==='quiz') detail=+{t.points} pts;
    cont.innerHTML+=<tr><td>{d}</td><td>{t.type}</td><td>{detail}</td></tr>;
  });
  cont.innerHTML+='</table>';
}

// ==================== LOJISTA ====================
function refreshShop() {
  const u = currentUser(); if(!u) return;
  document.getElementById('shop-name').textContent = u.store;
  const redeems = db.transactions.filter(t=>t.storeId===u.id && t.type==='redeem');
  const clients = [...new Set(redeems.map(r=>r.userId))].length;
  const total = redeems.reduce((s,t)=>s+(t.discount||0),0);
  document.getElementById('shop-redeems').textContent = redeems.length;
  document.getElementById('shop-clients').textContent = clients;
  document.getElementById('shop-total').textContent = fmtMoney(total);
}

function validateCoupon() {
  const code = document.getElementById('val-code').value.trim().toUpperCase();
  const u = currentUser();
  const cont = document.getElementById('val-result');

  if(!code) { toast('Digite o código!','error'); return; }
  const t = db.transactions.find(x=>x.code===code);
  if(!t) { cont.innerHTML='<div class="toast error" style="position:static;">❌ Cupom não encontrado!</div>'; sndWrong(); return; }
  if(t.storeId!==u.id) { cont.innerHTML='<div class="toast error" style="position:static;">⚠️ Cupom de outra loja!</div>'; sndWrong(); return; }
  if(t.status==='validado') { cont.innerHTML='<div class="toast error" style="position:static;">⚠️ Cupom já utilizado!</div>'; return; }

  t.status = 'validado';
  saveDB();
  sndCorrect();
  cont.innerHTML=
    <div class="card" style="background:rgba(39,174,96,0.2);border-color:var(--green);">
      <h3 style="color:var(--green);">✅ Cupom Válido!</h3>
      <p><strong>Cliente:</strong> {t.userName}</p>
      <p><strong>Desconto:</strong> {fmtMoney(t.discount)}</p>
      <p><strong>Compra:</strong> {fmtMoney(t.purchaseValue)}</p>
      <p>Aplique o desconto e entregue o produto.</p>
    </div>;
  document.getElementById('val-code').value='';
  refreshShop();
}

function addOffer() {
  const name=document.getElementById('offer-name').value.trim();
  const desc=document.getElementById('offer-desc').value.trim();
  const pts=parseInt(document.getElementById('offer-pts').value);
  const stock=parseInt(document.getElementById('offer-stock').value);
  const u=currentUser();

  if(!name||!desc||!pts||!stock) { toast('Preencha tudo!','error'); return; }
  if(pts<1000) { toast('Mínimo 1000 pontos!','error'); return; }

  db.offers.push({ id:Date.now(), name, desc, points:pts, stock, storeId:u.id, storeName:u.store, createdAt:new Date().toISOString() });
  saveDB();
  sndCorrect(); toast('Oferta criada!','success');
  ['offer-name','offer-desc','offer-pts','offer-stock'].forEach(id=>document.getElementById(id).value='');
  showScreen('scr-shopkeeper');
}

function renderShopProducts() {
  const u=currentUser(); if(!u) return;
  const list=db.offers.filter(o=>o.storeId===u.id);
  const cont=document.getElementById('shop-prod-list');
  if(!list.length) { cont.innerHTML='<p style="opacity:0.6;text-align:center;padding:15px;">Nenhuma oferta cadastrada.</p>'; return; }
  cont.innerHTML='';
  list.forEach(o => {
    cont.innerHTML+=<div class="prod-card"><div><h4>{o.name}</h4><p style="font-size:0.85em;opacity:0.8;">{o.desc}</p><small>{o.points} pts | Estoque: {o.stock}</small></div><button class="btn btn-red btn-sm" onclick="deleteOffer({o.id})">🗑️</button></div>;
  });
}

function deleteOffer(id) {
  if(!confirm('Excluir oferta?')) return;
  db.offers=db.offers.filter(o=>o.id!==id); saveDB(); renderShopProducts(); toast('Oferta excluída','info');
}

